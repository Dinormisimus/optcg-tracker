# Osnovne postavke aplikacije
APP_NAME="One Piece TCG Tracker API"
ENV="dev"

# Baza podataka (postgresql+asyncpg za asinkroni SQLAlchemy)
DATABASE_URL="postgresql+asyncpg://optcg_user:optcg_password@localhost:5432/optcg_db"

# JWT Autentifikacija i sigurnost
JWT_SECRET="change-this-in-production-secret-key-32-chars-long"
JWT_ISSUER="sit-unizd"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7